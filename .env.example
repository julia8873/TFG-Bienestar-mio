# String aleatorio de 32-64 caracteres. Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key

# Clave Fernet para cifrar en la BD las API keys de los usuarios (Clockify e IA).
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (alternativa sin instalar nada: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())")
FERNET_SECRET_KEY=your_fernet_secret_key


# URI de conexión a la base de datos MongoDB. Puede ser local o en la nube (MongoDB Atlas).
# MONGODB_URI=mongodb://db:27017/tfg_bienestar #para local
# MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@tfg-bienestar.p1qidsn.mongodb.net/?appName=TFG-Bienestar
MONGODB_URI=your_mongodb_uri

# Proveedor LLM activo. Valores posibles: gemini, openai (este último usa la API de NVIDIA)
LLM_PROVIDER=gemini

# URL(s) del frontend permitidas por CORS, separadas por comas y sin "/" final.
# En producción: la URL de Vercel, p. ej. https://tfg-bienestar.vercel.app
# Si no se define, solo se permite http://localhost:3000 (desarrollo local).
# CORS_ORIGINS=https://tfg-bienestar.vercel.app

# API key del LLM: OPCIONAL y solo para desarrollo local.
# En producción NO se define: cada usuario añade la suya desde la interfaz (Configuración > IA)
# y se guarda cifrada en la base de datos. Si la defines aquí, se usará como alternativa
# para los usuarios que no hayan configurado la suya.
# GEMINI_API_KEY=your_gemini_api_key     # si LLM_PROVIDER=gemini
# NVIDIA_API_KEY=your_nvidia_api_key     # si LLM_PROVIDER=openai

